# ==============================================================================
# ConsentHub — Git Ignore Configuration
# ==============================================================================

# Environment & Local Secrets (NEVER commit real secrets; keep .env.example)
.env
.env.*
!.env.example

# Java / Maven / Spring Boot
target/
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# Node / Frontend / Vite / TypeScript
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.tsbuildinfo
.eslintcache
.vite/

# Test & Coverage Reports
coverage/
**/coverage/
.nyc_output/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/
test-results/
**/test-results/
playwright/.cache/

# Keep Gate 5 verification screenshots tracked in Git
!docs/screenshots/
!docs/screenshots/*.png
!docs/screenshots/*.jpg
!docs/screenshots/*.webp

# Logs & Runtime Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
docker-compose.log
pids
*.pid
*.seed
*.pid.lock

# IDEs & Editors
.idea/
*.iws
*.iml
*.ipr
.vscode/*
!.vscode/extensions.json
.settings/
.classpath
.project

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
