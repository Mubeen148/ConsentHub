# ==============================================================================
# ConsentHub — Local Development Environment Template (.env.example)
# ==============================================================================
# Copy to `.env` for local customization:
#   cp .env.example .env
#
# NOTE: All values below are SAFE LOCAL-DEV DEFAULTS ONLY (zero production
# secrets). Running `docker compose up --build -d` works out of the box even
# without creating `.env` thanks to matching `${VAR:-default}` fallbacks in
# `docker-compose.yml`.
#
# In `prod` (`SPRING_PROFILES_ACTIVE=prod`), external high-entropy secrets
# MUST be injected via your secret manager / deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL 16 Database
# ------------------------------------------------------------------------------
POSTGRES_DB=consenthub
POSTGRES_USER=consenthub
POSTGRES_PASSWORD=consenthub_local_dev_only
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Spring Boot 3 Backend Runtime & Security
# ------------------------------------------------------------------------------
# Active profile: `docker` in Docker Compose, `default` for host CLI, `prod` in production
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080

# HMAC-SHA256 signing key for `ch_access_token` httpOnly JWTs (>= 32 bytes required)
JWT_SECRET=local-dev-only-change-in-prod-minimum-32-bytes-hmac-key-2026
JWT_EXPIRATION_SECONDS=86400

# Set `true` in HTTPS production so `Secure` is appended to session & CSRF cookies
APP_COOKIE_SECURE=false

# Server-side privacy salt used to compute pseudonymous SHA-256 `ip_hash` proofs
# (raw client IP addresses are NEVER persisted in PostgreSQL or logs)
IP_HASH_SALT=local-dev-only-ip-privacy-salt-2026

# Comma-separated allowlist for credentialed first-party SPA requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Enable GraphQL introspection in local/dev (`false` in production)
GRAPHQL_INTROSPECTION_ENABLED=true

# ------------------------------------------------------------------------------
# Frontend (Vite Dev Server / Docker Nginx Reverse Proxy) & Embeddable SDK
# ------------------------------------------------------------------------------
# Host port mapped to the frontend container (5173 matches local `npm run dev`)
FRONTEND_PORT=5173

# Leave empty so SPA requests use same-origin `/api/v1/*` and `/graphql` proxy
VITE_API_BASE_URL=

# Pre-seeded demo publishable SDK API key for `/sdk-demo.html` & local E2E verification
# (SHA-256 hash stored in `api_keys`: 37f0f4a4131b49bae8a6ffcdfbc8c585b7972459cfeb3d5d8a65d37b407abb1d)
DEMO_SDK_API_KEY=ch_live_demo_public_sdk_key_2026
VITE_DEMO_SDK_API_KEY=ch_live_demo_public_sdk_key_2026
